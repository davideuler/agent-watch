# =============================================================
# Agent Watch — environment configuration template
# Cloudflare deploy: copy values into `wrangler secret put <NAME>`
# Local dev: place these in `.dev.vars` (loaded by wrangler dev)
# =============================================================

# --- Projects to monitor (comma-separated slug=owner/repo) ----
PROJECTS=openclaw=openclaw/openclaw,hermes=nousresearch/hermes-agent
DEFAULT_PROJECT=openclaw

# --- Public site origin (for OAuth redirect_uri) --------------
PUBLIC_BASE_URL=https://agentwatch.aicompass.dev

# --- GitHub API ------------------------------------------------
# Optional but strongly recommended (raises rate limit 60→5000/hr)
GITHUB_TOKEN=

# --- LLM (OpenAI-compatible; works for OpenAI / Claude / 3rd party) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-5-mini
LLM_API_KEY=

# --- GitHub OAuth (login) -------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Google OAuth (login) -------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Session secret (random 32+ char string for HMAC) ---------
SESSION_SECRET=change-me-to-a-long-random-string
